# IntentShield CTI Backend Environment Configuration
PROJECT_NAME="IntentShield CTI Backend"
VERSION="1.4.0"
API_V1_STR="/api"

# JWT Security
SECRET_KEY="intentguard_super_secret_jwt_key_secure_and_reliable_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Standalone local SQLite; set to postgresql+asyncpg://... for production)
DATABASE_URL="sqlite+aiosqlite:///./intentguard.db"
SYNC_DATABASE_URL="sqlite:///./intentguard.db"

# Storage
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"

# Default Platform Admin Credentials
DEFAULT_ADMIN_EMAIL="admin@intentguard.sec"
DEFAULT_ADMIN_PASSWORD="AdminPassword123!"
DEFAULT_ADMIN_NAME="Bharath (Lead Admin)"

# CORS (JSON format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "*"]
