# Environment Configuration
PROJECT_NAME="IntentShield CTI Backend"
API_V1_STR="/api"
SECRET_KEY="change_this_super_secret_jwt_key_for_production_use_intentguard"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL in Docker / Local SQLite fallback)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/intentguard"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intentguard"

# Celery & Redis
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Storage Configuration (MinIO / S3 / Local fallback)
STORAGE_TYPE="local" # "local" or "s3"
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="intentguard-apks"
MINIO_SECURE=false

# Default Admin User
DEFAULT_ADMIN_EMAIL="admin@intentguard.sec"
DEFAULT_ADMIN_PASSWORD="AdminPassword123!"
DEFAULT_ADMIN_NAME="Bharath (Lead Admin)"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "*"]
